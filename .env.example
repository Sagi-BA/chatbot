# LLM Configuration
MODEL_TYPE="chatgpt"  # "chatgpt" or "qroq"
MAX_TOKENS=1024
LLM_MODEL="gpt-4o"  # or "llama3-70b-8192" for Groq

# API Keys
OPENAI_API_KEY="<YOURS>"  # Required if MODEL_TYPE="chatgpt"
GROQ_API_KEY="<YOURS>"  # Required if MODEL_TYPE="qroq"

# Embedding Configuration (NEW - MPA/sambert Hebrew-optimized)
EMBEDDING_METHOD="local"  # "local" (recommended) or "huggingface"
HUGGINGFACE_API_KEY="<YOURS>"  # Optional for local, required for huggingface method
EMBEDDING_METHOD="local"



